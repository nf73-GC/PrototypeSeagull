{
    "m_SGVersion": 1,
    "m_Type": "UnityEditor.ShaderGraph.CustomFunctionNode",
    "m_ObjectId": "0f5546e35c114869924dbb3c61f9c551",
    "m_Group": {
        "m_Id": ""
    },
    "m_Name": "SmoothVoronoi (Custom Function)",
    "m_DrawState": {
        "m_Expanded": true,
        "m_Position": {
            "serializedVersion": "2",
            "x": -1130.0,
            "y": 7.999985694885254,
            "width": 241.0,
            "height": 166.0
        }
    },
    "m_Slots": [
        {
            "m_Id": "713fcf01d9e4426bb4ddadc13c87ce55"
        },
        {
            "m_Id": "f95e4d56b5ac4d618d1c9db944baf79d"
        },
        {
            "m_Id": "18ac9b7ff7264625b91b43501a54d117"
        },
        {
            "m_Id": "562edbc970334a83afcdabf854315571"
        },
        {
            "m_Id": "78045b163ebf4e04bd7e8ec7c533a511"
        }
    ],
    "synonyms": [
        "code",
        "HLSL"
    ],
    "m_Precision": 0,
    "m_PreviewExpanded": false,
    "m_DismissedVersion": 0,
    "m_PreviewMode": 0,
    "m_CustomColors": {
        "m_SerializableColors": []
    },
    "m_SourceType": 1,
    "m_FunctionName": "SmoothVoronoi",
    "m_FunctionSource": "",
    "m_FunctionSourceUsePragmas": true,
    "m_FunctionBody": "float2 g = floor(UV * CellDensity);\r\nfloat2 f = frac(UV * CellDensity);\r\nfloat res = 0.0;\r\n\r\nfor (int y = -1; y <= 1; y++) \r\n{\r\n    for (int x = -1; x <= 1; x++) \r\n    {\r\n        float2 lattice = float2(x, y);\r\n        \r\n        // Hash inline (remplace la fonction hash2D)\r\n        float2 p = g + lattice;\r\n        float2 offset = frac(sin(float2(dot(p, float2(127.1, 311.7)), dot(p, float2(269.5, 183.3)))) * 43758.5453);\r\n        \r\n        offset = 0.5 + 0.5 * sin(AngleOffset + offset * 6.2831853);\r\n        float2 r = lattice + offset - f;\r\n        float d = dot(r, r);\r\n        res += exp2(-Smoothness * d);\r\n    }\r\n}\r\n\r\nOut = -(1.0 / max(Smoothness, 0.0001)) * log2(max(res, 0.0001));"
}

