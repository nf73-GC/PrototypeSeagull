    "m_Name": "Foam (Custom Function)",
    "m_DrawState": {
        "m_Expanded": true,
        "m_Position": {
            "serializedVersion": "2",
            "x": 391.0002136230469,
            "y": 1530.9998779296875,
            "width": 265.9998474121094,
            "height": 293.0
        }
    },
    "m_Slots": [
        {
            "m_Id": "25614d99742745f28858cc5115307ac5"
        },
        {
            "m_Id": "f280df0b0bec435991a5d2f05954c221"
        },
        {
            "m_Id": "2f8a8c7cfeb24fa789c58a7def29b90c"
        },
        {
            "m_Id": "c541cb1759bd41ed9717e31a1a2677f1"
        },
        {
            "m_Id": "80b79bb84a704e03b2cd3e6634a428d5"
        },
        {
            "m_Id": "029d6cc675de4598a10d19b676cd821a"
        },
        {
            "m_Id": "c84c6b7ff9084a9fab1bca8b4a1abece"
        },
        {
            "m_Id": "c74b40af99b54782aae3b5d95674b94f"
        },
        {
            "m_Id": "b6082ffe16d849fcb691d85b171699a6"
        },
        {
            "m_Id": "6bff5d5a208a40eb9e5db9ea3b142fa5"
        },
        {
            "m_Id": "7e92a4b6aa7e44e68589ac540d03a456"
        }
    ],
    "synonyms": [
        "code",
        "HLSL"
    ],
    "m_Precision": 0,
    "m_PreviewExpanded": false,
    "m_DismissedVersion": 0,
    "m_PreviewMode": 0,
    "m_CustomColors": {
        "m_SerializableColors": []
    },
    "m_SourceType": 1,
    "m_FunctionName": "Foam",
    "m_FunctionSource": "",
    "m_FunctionSourceUsePragmas": true,
    "m_FunctionBody": "float Dist = SDFTex.Sample(SDFTexSampler, UV).r;\r\n\r\nfloat2 animatedUV = UV * NoiseScale + float2(Time * FoamSpeed, Time * FoamSpeed * 0.5);\r\nfloat Noise = FoamNoiseTex.Sample(FoamNoiseSampler, animatedUV).r;\n\r\nfloat FoamDist = Dist - (Noise * _NoiseImpact);\r\n\nFoamMask = smoothstep(FoamWidth, 0.0, FoamDist);"
}

